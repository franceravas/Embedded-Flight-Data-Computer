			)
		)
		(uuid "0677d17b-48fb-411a-ad77-b2aae1e98102")
	)
	(text "10k ohm, pulls down to 0 and draws almost negligible current,\nbut allows to be pulled up by 3V3 easily\n"
		(exclude_from_sim no)
		(at 138.43 154.432 0)
		(effects
			(font
				(size 0.635 0.635)
			)
			(justify left)
		)
		(uuid "1ae25447-a5fc-40a3-ade0-05f5099cf848")
	)
	(text "Place debouncing cap as close as possible to NRST. \nIf driven low system resets. This chip already has built in VDD\nto keep it logic high\n"
		(exclude_from_sim no)
		(at 166.878 131.572 0)
		(effects
			(font
				(size 0.762 0.762)
			)
		)
		(uuid "30907391-0f7e-468b-afd6-b8777fd806fb")
	)
	(text "Stated on the datasheet that these \nwere the pins for SWD configuration"
		(exclude_from_sim no)
